{
  "name": "english_game",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:all": "node scripts/dev-all.mjs",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "test": "vitest run",
    "dev:room": "wrangler dev --config workers/room/wrangler.jsonc --port 8787",
    "smoke:room": "node scripts/room-smoke.mjs",
    "deploy": "nuxt build && wrangler deploy --config .output/server/wrangler.json",
    "deploy:room": "wrangler deploy --config workers/room/wrangler.jsonc"
  },
  "dependencies": {
    "nuxt": "^4.6.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "vitest": "^5.1.0",
    "wrangler": "4.159.0"
  },
  "overrides": {
    "nitropack": "npm:nitropack-nightly@latest"
  },
  "workspaces": ["."]
}
